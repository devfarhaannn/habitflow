generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String            @id @default(uuid())
  name                String?
  email               String            @unique
  emailVerified       DateTime?
  firstName           String?
  lastName            String?
  passwordHash        String?
  image               String?
  timezone            String            @default("UTC")
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  onboardingCompleted Boolean           @default(false)
  accounts            Account[]
  habitCategories     HabitCategory[]
  sessions            Session[]
  habitChecks         HabitCompletion[]
  habitDailyStats     HabitDailyStat[]
  habitReminders      HabitReminder[]
  habits              Habit[]

  @@map("users")
}

model Habit {
  id               String            @id @default(uuid())
  order            Int               @default(autoincrement())
  userId           String
  title            String
  description      String?
  color            String            @default("#FFFFFF")
  icon             String            @default("ListTodo")
  goalType         HabitFrequency    @default(DAILY)
  targetPerDay     Int               @default(1)
  streakGoal       Int?
  categoryId       String
  status           HabitStatus       @default(ACTIVE)
  archivedAt       DateTime?         @db.Timestamptz(6)
  startDate        DateTime          @default(now()) @db.Timestamptz(6)
  endDate          DateTime?         @db.Timestamptz(6)
  reminderEnabled  Boolean           @default(false)
  currentStreak    Int               @default(0)
  longestStreak    Int               @default(0)
  totalCompletions Int               @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  isFavorite       Boolean           @default(false)
  habitChecks      HabitCompletion[]
  habitDailyStats  HabitDailyStat[]
  habitReminders   HabitReminder[]
  category         HabitCategory     @relation(fields: [categoryId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, id])
  @@index([categoryId])
  @@map("habits")
}

model HabitCategory {
  id     String  @id @default(uuid())
  title  String
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@index([userId])
}

model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String
  date        DateTime @default(now()) @db.Timestamptz(6)
  completedAt DateTime @default(now()) @db.Timestamptz(6)
  userId      String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([habitId])
  @@index([date])
  @@index([habitId, date])
  @@index([userId, date])
  @@map("habit_completions")
}

model HabitDailyStat {
  id              String   @id @default(uuid())
  habitId         String
  userId          String
  date            DateTime @default(now()) @db.Timestamptz(6)
  completionCount Int      @default(0)
  targetCount     Int      @default(1)
  habit           Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@index([habitId, date])
  @@index([date])
  @@map("habit_daily_stats")
}

model HabitReminder {
  id         String   @id @default(uuid())
  userId     String
  habitId    String
  time       DateTime @db.Timestamptz(6)
  daysOfWeek Int[]
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  habit      Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("habit_reminders")
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum HabitStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ARCHIVED
}
